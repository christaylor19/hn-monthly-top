# OpenAI model used for summaries. The API KEY is no longer set here — each
# logged-in user supplies their own key, stored encrypted (see ENCRYPTION_KEY).
OPENAI_MODEL=gpt-4.1-mini

# Optional — without this, article fetching falls back to Jina free tier (rate-limited, no SLA)
JINA_API_KEY=

PORT=3000

# --- Database ----------------------------------------------------------------

# Postgres connection string. Locally, e.g. a Docker postgres:17 container.
# On Railway this is a reference variable to the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://hnmt:hnmt@localhost:5432/hnmt

# --- Auth (Better Auth) ------------------------------------------------------

# Random secret used to sign session cookies. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public origin the browser uses. Locally that is the Vite dev server, which
# proxies /api to this server. In production: https://hn-monthly-top.vercel.app
BETTER_AUTH_URL=http://localhost:5173

# Set to "true" to allow new accounts. Leave unset to block sign-up.
AUTH_SIGNUP_ENABLED=true

# Shared secret Vercel sends as x-origin-secret on /api requests it proxies.
# When set, /api requests without it are rejected. Leave empty locally.
ORIGIN_SECRET=

# --- Email (password reset) ----------------------------------------------------

# Password reset is on only when both are set. Leave empty to hide "Forgot password?".
# EMAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# --- Per-user key storage ----------------------------------------------------

# 32-byte base64 key used to AES-256-GCM encrypt users' OpenAI keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ROTATING this invalidates all stored keys — users must re-enter them.
ENCRYPTION_KEY=
