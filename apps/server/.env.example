# OpenAI model used for summaries. The API KEY is no longer set here — each
# logged-in user supplies their own key, stored encrypted (see ENCRYPTION_KEY).
OPENAI_MODEL=gpt-4.1-mini

# Optional — without this, article fetching falls back to Jina free tier (rate-limited, no SLA)
JINA_API_KEY=

# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
# In production this MUST be set to the deployed frontend origin
# (e.g. https://hn-monthly-top.vercel.app) so the backend rejects other origins.
CORS_ORIGIN=

PORT=3000

# --- Auth + per-user key storage ---------------------------------------------

# Supabase project URL and SERVICE ROLE key (server-only — never expose to the
# browser; it bypasses RLS). Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte base64 key used to AES-256-GCM encrypt users' OpenAI keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ROTATING this invalidates all stored keys — users must re-enter them.
ENCRYPTION_KEY=
