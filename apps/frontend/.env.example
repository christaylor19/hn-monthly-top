# Backend API URL. Leave empty in dev — Vite proxies /api to localhost:3000.
# Set in prod (e.g. https://hn-monthly-top.up.railway.app) so the frontend can reach the backend.
VITE_API_URL=

# Supabase (login). Safe to expose — the anon key only permits what RLS allows.
# Find these in Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
