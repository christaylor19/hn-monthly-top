{
  "name": "hn-monthly-top",
  "private": true,
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "yarn workspaces foreach -pi --all run dev",
    "dev:frontend": "yarn workspace @hn-monthly-top/frontend dev",
    "dev:server": "yarn workspace @hn-monthly-top/server dev",
    "build": "yarn workspaces foreach -pt --all run build",
    "build:frontend": "yarn workspace @hn-monthly-top/frontend build",
    "build:server": "yarn workspace @hn-monthly-top/server build",
    "start:server": "yarn workspace @hn-monthly-top/server start"
  }
}
