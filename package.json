{
  "name": "hn-monthly-top",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:frontend": "pnpm --filter @hn-monthly-top/frontend dev",
    "dev:server": "pnpm --filter @hn-monthly-top/server dev",
    "build": "pnpm -r run build",
    "build:frontend": "pnpm --filter @hn-monthly-top/frontend build",
    "build:server": "pnpm --filter @hn-monthly-top/server build",
    "start:server": "pnpm --filter @hn-monthly-top/server start",
    "check": "pnpm -r run check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "bash scripts/verify.sh",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-solid": "0.19.0",
    "jiti": "2.7.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.0",
    "railway": "3.16.0",
    "typescript-eslint": "8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
